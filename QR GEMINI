<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lector QR - BITAZETA</title>
  <style>
    body { font-family: 'Segoe UI', sans-serif; background-color: #0f172a; color: white; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; margin: 0; padding: 20px; text-align: center; }
    h2 { color: #0d9488; }
    #reader { width: 100%; max-width: 400px; background: white; border-radius: 12px; overflow: hidden; margin-top: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
    .btn { background-color: #f97316; color: white; border: none; padding: 12px 20px; border-radius: 6px; font-weight: 700; cursor: pointer; margin-top: 20px; font-size: 16px; }
    .btn:hover { background-color: #ea580c; }
    #status { margin-top: 15px; font-size: 14px; font-weight: bold; }
  </style>
  <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
</head>
<body>

  <h2>ESCANEAR AZETA</h2>
  <p>Apunte la cámara al código QR de la carpeta física.</p>

  <div id="reader"></div>
  <div id="status" style="color: #cbd5e1;">Cargando cámara...</div>

  <button class="btn" id="btn-restart" style="display:none;" onclick="iniciarEscaner()">VOLVER A ESCANEAR</button>

  <script>
    let html5QrcodeScanner;

    function onScanSuccess(decodedText, decodedResult) {
      // Detener escáner temporalmente para evitar lecturas múltiples
      if (html5QrcodeScanner) {
        html5QrcodeScanner.clear();
      }

      document.getElementById('status').style.color = '#10b981';
      document.getElementById('status').innerText = 'Código Detectado: ' + decodedText + '\nEnviando a BITAZETA...';
      document.getElementById('btn-restart').style.display = 'inline-block';

      // Enviar de vuelta a la ventana padre (Google Apps Script / BITAZETA)
      if (window.opener) {
        window.opener.postMessage({
          type: 'AZ_SCAN',
          code: decodedText
        }, '*'); // Para mayor seguridad, puedes cambiar '*' por 'https://script.google.com'
      } else {
        document.getElementById('status').style.color = '#ef4444';
        document.getElementById('status').innerText = 'No se encontró la aplicación BITAZETA abierta.';
      }
    }

    function onScanFailure(error) {
      // Los errores de lectura cuadro por cuadro se ignoran visualmente para no saturar al usuario
    }

    function iniciarEscaner() {
      document.getElementById('btn-restart').style.display = 'none';
      document.getElementById('status').style.color = '#cbd5e1';
      document.getElementById('status').innerText = 'Buscando código QR...';
      
      html5QrcodeScanner = new Html5QrcodeScanner(
        "reader",
        { fps: 10, qrbox: {width: 250, height: 250} },
        /* verbose= */ false
      );
      html5QrcodeScanner.render(onScanSuccess, onScanFailure);
    }

    // Comprobar parámetros de sesión
    window.onload = function() {
      const urlParams = new URLSearchParams(window.location.search);
      const session = urlParams.get('session');
      
      if (!session) {
        document.getElementById('status').style.color = '#ef4444';
        document.getElementById('status').innerText = 'Acceso no autorizado. Inicie el escáner desde BITAZETA.';
      } else {
        iniciarEscaner();
      }
    }
  </script>
</body>
</html>
